{
    "compilerOptions": {
        "noImplicitAny": true,
        "target": "ES2022",
        "module": "CommonJS",
        "removeComments": true,
        "preserveConstEnums": true,
        "outDir": "./public",
        "sourceMap": true,
        "jsx": "react-jsx",
        "lib": [
            "dom",
        ],
        "plugins": [
            { "name": "typescript-tslint-plugin" }
          ]
    },
    "include": [
        "src/**/*",
        "__tests__/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}